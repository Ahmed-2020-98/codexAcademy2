{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "regions": ["fra1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 60
        }
    },
    "rewrites": [
        { "source": "/(.*)", "destination": "/api/index.php" }
    ],
    "git": {
        "deploymentEnabled": {
            "main": false,
            "preview": true
        }
    }
}
